# ============================================================
# NFTCowCert V2 — .env.example  (safe template; no secrets)
# Copy to .env and fill in real testnet values. NEVER commit .env.
# Every variable below is consumed by the code; placeholders only.
# ============================================================

# ---- Wallets (testnet throwaway only; never real-value keys) ----
PRIVATE_KEY=YOUR_ADMIN_ISSUER_PRIVATE_KEY
PRIVATE_KEY_1=YOUR_OWNER1_PRIVATE_KEY
PRIVATE_KEY_2=YOUR_OWNER2_PRIVATE_KEY
PRIVATE_KEY_3=YOUR_OWNER3_PRIVATE_KEY
PRIVATE_KEY_BNB=YOUR_BNB_TESTNET_PRIVATE_KEY

ADDRESS_SIGN=0xYourAdminIssuerAddress
MINT_TO=0xYourMintRecipientAddress
TRANSFER_TO=0xYourOwner1Address
TRANSFER_TO_2=0xYourOwner2Address
TRANSFER_TO_3=0xYourOwner3Address

# ---- zkSync Era Sepolia (Layer-2) ----
ZKSYNC_RPC=https://sepolia.era.zksync.dev
ZKSYNC_RPC_URL=https://sepolia.era.zksync.dev
ZKSYNC_RPC_ALCHEMY=https://zksync-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ZKSYNC_CONTRACT=0xYourZkSyncContractAddress
ZKSYNC_CONTRACT_TEST=0xYourZkSyncContractAddress
ZKSYNC_CHAIN_ID=300

# ---- Ethereum Sepolia (Layer-1 baseline) ----
ETH_RPC=YOUR_ETHEREUM_SEPOLIA_RPC_URL
SEPOLIA_RPC_URL=YOUR_ETHEREUM_SEPOLIA_RPC_URL
SEPOLIA_CONTRACT=0xYourSepoliaContractAddress
ETH_CONTRACT_TEST=0xYourSepoliaContractAddress
SEPOLIA_CHAIN_ID=11155111

# ---- Optional extra networks (only if used) ----
BNB_RPC=YOUR_BNB_TESTNET_RPC_URL
OPTIMISM_RPC=YOUR_OPTIMISM_TESTNET_RPC_URL

# ---- IPFS (evaluated prototype: LOCAL node only) ----
# The prototype uses a local IPFS node over the HTTP API. No external
# pinning service / gateway failover is implemented or evaluated.
IPFS_API_HOST=localhost
IPFS_API_PORT=5001
IPFS_API_PROTOCOL=http
IPFS_INPUT_FILE=./file_logs/TEST-001-B1_5certs.json
IPFS_OUTPUT_FILE=./output/cid_list_test01.json

# ---- Benchmark settings ----
# BENCH_MODE=live|local ; BENCH_OP=mint|transfer|block|unblock
# BENCH_NS="100,500,1000" ; BENCH_CONC=3 ; BENCH_REPEAT_INDEX=1
BENCH_MODE=local
BENCH_OP=mint
BENCH_NS=5,10
BENCH_CONC=3
BENCH_REPEAT_INDEX=1
BENCH_RECEIPT_TIMEOUT_MS=120000
BENCH_OUT=benchmark-final-results

# ---- Event-replay settings (optional) ----
REPLAY_NS=100,500,1000
REPLAY_TOKENS=
REPLAY_FROM_BLOCK=
REPLAY_TO_BLOCK=

# ---- Telemetry off ----
HARDHAT_TELEMETRY_DISABLED=true
DISABLE_POSTHOG=true
POSTHOG_DISABLED=true
